    "def train_critic(generator, critic, real_images, optimizer_D, z_dim, device):\n",
    "    batch_size = real_images.size(0)\n",
    "\n",
    "    # Generate fake images\n",
    "    z = torch.randn(batch_size, z_dim, device=device)\n",
    "    fake_images = generator(z)\n",
    "\n",
    "    # Compute Wasserstein loss\n",
    "    real_scores = critic(real_images)\n",
    "    fake_scores = critic(fake_images.detach())\n",
    "    critic_loss = torch.mean(fake_scores) - torch.mean(real_scores)\n",
    "\n",
    "    # Update critic parameters\n",
    "    optimizer_D.zero_grad()\n",
    "    critic_loss.backward()\n",
    "    optimizer_D.step()\n",
    "\n",
    "    # Weight clipping\n",
    "    for p in critic.parameters():\n",
    "        p.data.clamp_(-0.01, 0.01)\n",
    "\n",
    "    return critic_loss.item()\n",
    "\n",
    "def train_generator(generator, critic, optimizer_G, batch_size, z_dim, device):\n",
    "    z = torch.randn(batch_size, z_dim, device=device)\n",
    "\n",
    "    fake_images = generator(z)\n",
    "\n",
    "    # Compute generator loss\n",
    "    fake_scores = critic(fake_images)\n",
    "    generator_loss = -torch.mean(fake_scores)\n",
    "\n",
    "    # Update generator parameters\n",
    "    optimizer_G.zero_grad()\n",
    "    generator_loss.backward()\n",
    "    optimizer_G.step()\n",
    "\n",
    "    return generator_loss.item()"
   ]
