    "def interpolate_samples(real_images, fake_images):\n",
    "    \"\"\"\n",
    "    Creates random interpolations between real and generated images.\n",
    "\n",
    "    Args:\n",
    "        real_images: Tensor of real images with shape (B, C, H, W).\n",
    "        fake_images: Tensor of generated images with shape (B, C, H, W).\n",
    "\n",
    "    Returns:\n",
    "        interpolated_images: Tensor with shape (B, C, H, W).\n",
    "    \"\"\"\n",
    "\n",
    "    batch_size = real_images.size(0)\n",
    "\n",
    "    alpha = torch.rand(batch_size, 1, 1, 1, device=real_images.device)\n",
    "    differences = fake_images - real_images\n",
    "    interpolated_images = real_images + (alpha * differences)\n",
    "    return interpolated_images"
   ]
