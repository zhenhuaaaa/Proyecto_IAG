    "def gradient_penalty(critic, interpolated_images):\n",
    "    \"\"\"\n",
    "    Computes the gradient penalty for WGAN-GP.\n",
    "\n",
    "    Args:\n",
    "        critic: WGAN-GP critic network.\n",
    "        interpolated_images: Tensor of interpolated images\n",
    "                             with shape (B, C, H, W).\n",
    "\n",
    "    Returns:\n",
    "        gradient_penalty: Scalar gradient penalty.\n",
    "    \"\"\"\n",
    "\n",
    "    interpolated_images = interpolated_images.detach().requires_grad_(True)\n",
    "\n",
    "    interpolated_scores = critic(interpolated_images)\n",
    "\n",
    "    gradients = torch.autograd.grad(\n",
    "        outputs=interpolated_scores,\n",
    "        inputs=interpolated_images,\n",
    "        grad_outputs=torch.ones_like(interpolated_scores),\n",
    "        create_graph=True,\n",
    "        retain_graph=True\n",
    "    )[0]\n",
    "\n",
    "    # (B, C, H, W) -> (B, C*H*W)\n",
    "    gradients = gradients.reshape(gradients.size(0), -1)\n",
    "\n",
    "    # Compute the L2 norm of the gradient for each image\n",
    "    slopes = gradients.norm(2, dim=1)\n",
    "\n",
    "    # Gradient penalty\n",
    "    gradient_penalty = ((slopes - 1.0) ** 2).mean()\n",
    "\n",
    "    return gradient_penalty"
   ]
