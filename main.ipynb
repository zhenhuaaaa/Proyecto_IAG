    "CRITIC_ITERATIONS = 5\n",
    "N_ITERATIONS = 200000\n",
    "\n",
    "CHECKPOINT_DIR = \"checkpoints/wgan_bn\"\n",
    "CHECKPOINT_PATH = os.path.join(CHECKPOINT_DIR, \"checkpoint.pth\")\n",
    "CHECKPOINT_INTERVAL = 2500\n",
    "\n",
    "generator = Generator(latent_dim=z_dim, dim=128).to(device)\n",
    "critic = Critic(dim=128).to(device)\n",
    "\n",
    "optimizer_G = torch.optim.RMSprop(generator.parameters(), lr=5e-5)\n",
    "optimizer_D = torch.optim.RMSprop(critic.parameters(), lr=5e-5)\n",
    "\n",
    "generator_losses = []\n",
    "critic_losses = []\n",
    "\n",
    "start_iteration = 0\n",
    "\n",
    "# Recuperar checkpoint si existe\n",
    "if os.path.exists(CHECKPOINT_PATH):\n",
    "    print(f\"Checkpoint encontrado: {CHECKPOINT_PATH}\")\n",
    "    print(\"Cargando checkpoint...\")\n",
    "\n",
    "    checkpoint = torch.load(\n",
    "        CHECKPOINT_PATH,\n",
    "        map_location=device\n",
    "    )\n",
    "\n",
    "    generator.load_state_dict(checkpoint[\"generator\"])\n",
    "    critic.load_state_dict(checkpoint[\"critic\"])\n",
    "\n",
    "    optimizer_G.load_state_dict(checkpoint[\"optimizer_G\"])\n",
    "    optimizer_D.load_state_dict(checkpoint[\"optimizer_D\"])\n",
    "\n",
    "    generator_losses = checkpoint[\"generator_losses\"]\n",
    "    critic_losses = checkpoint[\"critic_losses\"]\n",
    "\n",
    "    start_iteration = checkpoint[\"iteration\"] + 1\n",
    "\n",
    "    print(f\"Entrenamiento recuperado desde la iteración {start_iteration}\")\n",
    "\n",
    "else:\n",
    "    print(\"No se ha encontrado ningún checkpoint.\")\n",
    "    print(\"Comenzando entrenamiento desde cero.\")\n",
    "\n",
    "\n",
    "train_iterator = cycle(train_loader)\n",
    "\n",
    "for iteration in range(start_iteration, N_ITERATIONS):\n",
    "\n",
    "    for _ in range(CRITIC_ITERATIONS):\n",
    "\n",
    "        real_images, _ = next(train_iterator)\n",
    "        real_images = real_images.to(device)\n",
    "\n",
    "        critic_loss = train_critic(\n",
    "            generator,\n",
    "            critic,\n",
    "            real_images,\n",
    "            optimizer_D,\n",
    "            z_dim,\n",
    "            device\n",
    "        )\n",
    "\n",
    "        critic_losses.append(critic_loss)\n",
    "\n",
    "    generator_loss = train_generator(\n",
