    "class Critic(nn.Module):\n",
    "    def __init__(self, dim=128):\n",
    "        super().__init__()\n",
    "\n",
    "        self.dim = dim\n",
    "\n",
    "        self.conv1 = nn.Conv2d(3, dim, kernel_size=5, stride=2, padding=2)\n",
    "\n",
    "        self.leaky_relu = nn.LeakyReLU(0.2)\n",
    "\n",
    "        self.conv2 = nn.Conv2d(dim, 2 * dim, kernel_size=5, stride=2, padding=2)\n",
    "\n",
    "        self.bn2 = nn.BatchNorm2d(2 * dim) #NOTE: en caso de sin batch normalization, comentar esta línea\n",
    "\n",
    "        self.conv3 = nn.Conv2d(2 * dim, 4 * dim, kernel_size=5, stride=2, padding=2)\n",
    "\n",
    "        self.bn3 = nn.BatchNorm2d(4 * dim) #NOTE: en caso de sin batch normalization, comentar esta línea\n",
    "\n",
    "        self.linear = nn.Linear(4 * 4 * 4 * dim, 1)\n",
    "\n",
    "    def forward(self, x):\n",
    "        # 32x32 -> 16x16\n",
    "        x = self.conv1(x)\n",
    "        x = self.leaky_relu(x)\n",
    "\n",
    "        # 16x16 -> 8x8\n",
    "        x = self.conv2(x)\n",
    "        x = self.bn2(x) #NOTE: en caso de sin batch normalization, comentar esta línea\n",
    "        x = self.leaky_relu(x)\n",
    "\n",
    "        # 8x8 -> 4x4\n",
    "        x = self.conv3(x)\n",
    "        x = self.bn3(x) #NOTE: en caso de sin batch normalization, comentar esta línea\n",
    "        x = self.leaky_relu(x)\n",
    "\n",
    "        # Flatten\n",
    "        x = x.view(-1, 4 * 4 * 4 * self.dim)\n",
    "\n",
    "        # Linear transformation\n",
    "        x = self.linear(x)\n",
    "\n",
    "        return x"
   ]
